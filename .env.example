# Writable directory for the SQLite database and generated exports.
ERRORBOOK_DATA_DIR=./data

# Used for weekly review boundaries and PDF timestamps.
ERRORBOOK_TIMEZONE=Asia/Tokyo

# FSRS target recall probability. 0.90 is a practical default.
ERRORBOOK_DESIRED_RETENTION=0.90

# Optional. Auto-detected on Windows, macOS, and common Linux installs.
# ERRORBOOK_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Optional override for a Chinese-capable UI font used in generated PDFs.
# ERRORBOOK_PDF_FONT="Microsoft YaHei"

# Log level. Logs are written to stderr so stdio MCP framing stays intact.
ERRORBOOK_LOG_LEVEL=INFO
